{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noExcessiveCognitiveComplexity": "warn",
				"noBannedTypes": "error"
			},
			"performance": {
				"noDelete": "warn"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useConst": "warn",
				"useTemplate": "warn",
				"useNodejsImportProtocol": "warn",
				"noUnusedTemplateLiteral": "warn"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noControlCharactersInRegex": "warn",
				"noAssignInExpressions": "error",
				"noShadowRestrictedNames": "error",
				"noImplicitAnyLet": "error",
				"noThenProperty": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "none"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/package.json", ".changeset/*.json"],
			"formatter": { "enabled": false }
		}
	]
}
