{
	"extends": "../tsconfig.base.json",
	"compilerOptions": {
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@lib/*": [
				"./src/lib/*"
			],
			"@utils/*": [
				"./src/utils/*"
			],
			"#types/*": [
				"./src/types/*"
			]
		}
	},
	"include": [
		"env.d.ts",
		"src/**/*",
		"tests/**/*"
	]
}
